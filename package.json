{
  "name": "calculus-suite-pro",
  "version": "3.1.0",
  "description": "Browser-based calculus workstation: derivatives, integrals, series, limits, ODEs, multivariable calculus and live plots.",
  "private": true,
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "serve": "python3 -m http.server 8080",
    "e2e": "node tests/e2e/ui-checks.js && node tests/e2e/plot-checks.js && node tests/e2e/new-tools.js && node tests/e2e/home.js"
  },
  "devDependencies": {
    "playwright": "^1.49.0",
    "speech-rule-engine": "4.1.5"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./nlp": "./js/nlp.js",
    "./practice": "./js/practice.js"
  },
  "files": [
    "lib/",
    "js/engine.js",
    "js/extras.js",
    "js/nlp.js",
    "js/practice.js",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "keywords": [
    "calculus",
    "symbolic",
    "math",
    "derivative",
    "integral",
    "laplace",
    "offline",
    "education"
  ],
  "dependencies": {
    "algebrite": "1.4.0",
    "mathjs": "11.11.0"
  }
}
